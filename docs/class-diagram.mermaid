classDiagram
    class SSHHost {
        +int id
        +str name
        +str host_key
        +str hostname
        +int port
        +str username
        +str password
        +str os_type
    }
    class PluginManifest {
        +str id
        +str name
        +str category
        +list required_clients
        +list supports
        +dict packages
        +list verify_after_install
    }
    class PluginHostState {
        +int id
        +int host_id
        +str host_key
        +str plugin_id
        +str status
        +str version
        +str method
        +str extract_dir
        +str found_paths
        +str message
    }
    class PluginRuntime {
        +BUNDLED_PHYSICAL_TOOLS dict
        +bundled_physical_tools(db_type) list
        +external_plugins_for_db_type(db_type) list
        +remote_detect_os(ssh_host) str
        +remote_detect_package_manager(ssh_host) str
        +remote_check_clients(ssh_host, tools) dict
        +remote_bin_version(ssh_host, bin, args) str
    }
    class PluginCatalog {
        +load_all() dict
        +check_installed(manifest, ssh_host) dict
        +check_installed_on_host(plugin_id, ssh_host) dict
        +list_plugins(host_id) list
        +get_plugin(pid, host_id) dict
        +recommend_for_host(db_types, host_id) list
        +external_plugins_for_host(host_id) list
    }
    class PluginInstaller {
        +install(plugin_id, host_id) dict
        +uninstall(plugin_id, host_id) dict
        +get_state(plugin_id, host_id) dict
        +_select_strategy(manifest, ssh_host) dict
        +_remote_run_command(ssh_host, cmd, key) dict
        +_download_then_sftp_extract(ssh_host, strategy, key) dict
        +_verify_remote(manifest, ssh_host, key) dict
        +_upsert_state(key, plugin_id, host_id, host_key, state) None
    }
    class RemoteDump {
        +_connect(ssh_host) client
        +_wrap_login(shell) str
        +_resolve_remote_bin(client, tool) str
        +remote_has_tool(ssh_host, tool) bool
        +remote_exec_capture(ssh_host, shell, timeout) dict
        +sftp_put(ssh_host, local_path, remote_path) None
    }
    class BackupEngine {
        +db_type str
        +required_clients list
        +physical_bundled_tools list
        +physical_external_plugins list
        +check_client() tuple
        +preflight() tuple
        +_preflight_remote_physical(ssh_host) tuple
    }

    PluginInstaller --> PluginCatalog : 读 manifest / 状态
    PluginInstaller --> SSHHost : 解析安装目标
    PluginInstaller --> RemoteDump : 远端执行 / SFTP
    PluginInstaller --> PluginHostState : 写入状态
    PluginCatalog --> PluginManifest : 加载
    PluginCatalog --> PluginHostState : 读状态
    PluginCatalog --> PluginRuntime : 远端探测
    BackupEngine --> PluginRuntime : 分类 + 远端检查
    BackupEngine --> PluginCatalog : check_installed_on_host
    BackupEngine --> RemoteDump : resolve_ssh_host
