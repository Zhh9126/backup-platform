    %% ================= 工厂与消费方 =================
    class CDCFactory {
        <<module core.cdc>>
        +dict CDC_REGISTRY
        +dict ENGINE_DAEMON_MAP
        +create_daemon(task, rt_config, repo, logger) CDCDaemon
        +probe_clients() dict
        +supported_engines() tuple
    }

    class DbRtCapture {
        +CDCDaemon daemon
        +LogRepository repo
        +RecoveryJournal journal
        +start() None
        +tick() list
        +health() RtHealth
        #_daemon_position_fields(position) dict
        #_position_label(position) str
        #_persist_state(health) None
