classDiagram
    %% ================= T03 既有骨架（不可修改） =================
    class CDCDaemon {
        <<abstract>>
        +str engine_key
        +str display_name
        +list required_clients
        +bool is_simulated
        +bool seal_all_immediately
        +dict task
        +RtConfig rt
        +LogRepository repo
        +str degrade_reason
        +str last_error
        +Popen proc
        +__init__(task, rt_config, repo, logger)
        +check_client() tuple$
        +is_available(task) tuple$
        +start() None*
        +tick() list
        +seal_ready_segments(force) list
        +stop() None
        +is_alive() bool
        +current_position() dict
        +source_position() dict
        +lag_seconds() int
        +resume_from(position) None
        +state() dict
        +describe() dict
        #_popen(cmd, cwd, env) Popen
        #_kill() None
        #_auth_env() dict
        #_is_stalled(path) bool
    }

    class SimulatedCDCDaemon {
        +engine_key = "simulated"
        +is_simulated = True
        +start() None
        +tick() list
    }

    class MySQLBinlogDaemon {
        +engine_key = "mysql_binlog"
        +required_clients = ["mysqlbinlog"]
        +start() None
        +source_position() dict
    }

